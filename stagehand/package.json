{
  "name": "stripe-webmcp-stagehand",
  "version": "0.0.0",
  "private": true,
  "description": "Pay a Stripe Checkout page using its WebMCP tools and Stagehand.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env index.ts",
    "demo": "node --env-file-if-exists=.env index.ts --preview",
    "test": "node --test tools.test.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "4.2.0-alpha-5788121e60c2648654c2b36ec7755030f0015fab",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "26.x",
    "typescript": "~7.0.2"
  }
}
